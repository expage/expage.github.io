</description>
<Style id="bedrock">
<IconStyle>
<color>ff0000ff</color>
<colorMode>normal</colorMode>
<scale>1</scale>
<Icon>
<href>http://maps.google.com/mapfiles/kml/shapes/shaded_dot.png</href>
</Icon>
</IconStyle>
<BalloonStyle>
<text><![CDATA[<b><font size='4'>$[name]</font></b><br/><br/><u>Ref prod rate (at/g/yr)</u><br/>$[description]]]></text>
</BalloonStyle>
</Style>
