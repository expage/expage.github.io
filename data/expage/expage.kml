<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
<name>Expage</name>
<description>
<![CDATA[
Global glacial exposure ages<br/>
(data from expage-202610)<br/><br/>
<a href="http://expage.github.io/">expage.github.io</a>
]]>
</description>
<Style id="bedrock">
<IconStyle>
<color>ff0000ff</color>
<colorMode>normal</colorMode>
<scale>1</scale>
<Icon>
<href>http://maps.google.com/mapfiles/kml/shapes/shaded_dot.png</href>
</Icon>
</IconStyle>
<BalloonStyle>
<text><![CDATA[<b><font size='4'>$[name]</font></b><br/><br/><u>LSD age (yr)</u><br/>$[description]]]></text>
</BalloonStyle>
</Style>
<Style id="boulder">
<IconStyle>
<color>ff00ffff</color>
<colorMode>normal</colorMode>
<scale>1</scale>
<Icon>
<href>http://maps.google.com/mapfiles/kml/shapes/shaded_dot.png</href>
</Icon>
</IconStyle>
<BalloonStyle>
<text><![CDATA[<b><font size='4'>$[name]</font></b><br/><br/><u>LSD age (yr)</u><br/>$[description]]]></text>
</BalloonStyle>
</Style>
<Style id="other">
<IconStyle>
<color>ffff0000</color>
<colorMode>normal</colorMode>
<scale>1</scale>
<Icon>
<href>http://maps.google.com/mapfiles/kml/shapes/shaded_dot.png</href>
</Icon>
</IconStyle>
<BalloonStyle>
<text><![CDATA[<b><font size='4'>$[name]</font></b><br/><br/><u>LSD age (yr)</u><br/>$[description]]]></text>
</BalloonStyle>
</Style>

<Folder>
<name>Publication</name>
<Placemark>
<name>Sample</name>
<description>
<![CDATA[
<sup>10</sup>Be: 10Be-age(yr) &#177; 10-ext-unc(yr)<br/>
<sup>26</sup>Al: 26Al-age(yr) &#177; 26-ext-unc(yr)<br/>
<sup>14</sup>C: 14C-age(yr) &#177; 14-ext-unc(yr)<br/><br/>
<br/><u>Sample</u><br/>Sample-type<br/><br/>
<u>Publications</u><br/><a href="http://expage.github.io/data/txt/Publication.txt">Publication</a><br/>Extra-publ
]]>
</description>
<styleUrl>#other</styleUrl>
<Point>
<coordinates>Long(DD),Lat(DD)</coordinates>
</Point>
</Placemark>
